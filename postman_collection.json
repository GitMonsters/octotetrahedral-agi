            "description": "Run this 10 times sequentially in Postman's test runner to benchmark batch throughput",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.test('Status 200', function() {",
                    "    pm.response.to.have.status(200);",
                    "});",
                    "pm.test('Has predictions', function() {",
                    "    var data = pm.response.json();",
                    "    pm.expect(data).to.have.property('predictions');",
                    "});",
                    "pm.test('Has latency', function() {",
                    "    var data = pm.response.json();",
                    "    pm.expect(data).to.have.property('latency_ms');",
                    "});"
                  ]
                }
              }
            ]
          },
