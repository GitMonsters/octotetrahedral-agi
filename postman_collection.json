    {
      "name": "Performance Benchmarks",
      "item": [
        {
          "name": "Latency Test (Single)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer qU62MH7IOkLzFDUHCVJoRlrc41nzzNNa8-Hhnm2YwVQ"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"input_ids\": [1, 2, 3, 4, 5]}"
            },
            "url": {
              "raw": "http://localhost:8000/predict",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["predict"]
            },
            "description": "Measure single request latency",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "var response = pm.response.json();",
                    "var latency = response.latency_ms;",
                    "",
                    "pm.test('Latency < 5000ms', function() {",
                    "    pm.expect(latency).to.be.below(5000);",
                    "});",
                    "",
                    "pm.test('Latency > 0ms', function() {",
                    "    pm.expect(latency).to.be.above(0);",
                    "});",
                    "",
                    "console.log('📊 Latency: ' + latency + 'ms');"
                  ]
                }
              }
            ]
          },
          "response": []
        },
        {
          "name": "Throughput Test (Concurrent x5)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer qU62MH7IOkLzFDUHCVJoRlrc41nzzNNa8-Hhnm2YwVQ"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"input_ids\": [1, 2, 3]}"
            },
            "url": {
              "raw": "http://localhost:8000/predict",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["predict"]
            },
            "description": "Use Postman Runner to execute this 5 times concurrently",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.test('Success', function() {",
                    "    pm.response.to.have.status(200);",
                    "});",
                    "",
                    "if (!pm.collectionVariables.get('total_latency')) {",
                    "    pm.collectionVariables.set('total_latency', 0);",
                    "    pm.collectionVariables.set('request_count', 0);",
                    "}",
                    "",
                    "var latency = pm.response.json().latency_ms;",
                    "var total = parseInt(pm.collectionVariables.get('total_latency')) + latency;",
                    "var count = parseInt(pm.collectionVariables.get('request_count')) + 1;",
                    "",
                    "pm.collectionVariables.set('total_latency', total);",
                    "pm.collectionVariables.set('request_count', count);",
                    "",
                    "console.log('Request ' + count + ': ' + latency + 'ms | Avg: ' + (total/count).toFixed(2) + 'ms');"
                  ]
                }
              }
            ]
          },
          "response": []
        },
        {
          "name": "Stress Test (Large Batch)",
          "request": {
            "method": "POST",
            "header": [
